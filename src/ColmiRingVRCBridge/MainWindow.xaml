<Window x:Class="ColmiRingVRCBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ColmiRingVRCBridge.Models"
        Title="ColmiRingVRCBridge" Width="510" Height="780" MinWidth="420" MinHeight="490"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource WindowSurface}" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel Background="{StaticResource WindowSurface}">
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardSurface}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Margin="12,0,0,0"
                           VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <Grid>
                                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          Visibility="{Binding ShowDevicePicker, Converter={StaticResource BooleanVisibility}}"
                                          IsEnabled="{Binding CanSelectDevice}" DisplayMemberPath="DisplayText"
                                          AutomationProperties.Name="リングを選択"/>
                                <TextBlock Text="リングを選択" VerticalAlignment="Center" Margin="8,0,22,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowDevicePicker}" Value="True"/>
                                                        <Condition Binding="{Binding SelectedDevice}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ConnectedDeviceName}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowDevicePicker}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="{Binding ConnectionText}" ToolTip="{Binding ConnectionDetails}"
                                       TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionText}" Value="接続済み">
                                                <Setter Property="Foreground" Value="{StaticResource ConnectedInk}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="検索" Command="{Binding ScanCommand}" Margin="0,0,6,0" MinWidth="58"/>
                                <Button Content="{Binding ConnectionButtonText}" Command="{Binding ConnectionCommand}"
                                        Style="{StaticResource PrimaryButton}" MinWidth="65"/>
                            </StackPanel>
                            <CheckBox Content="自動再接続" IsChecked="{Binding AutoReconnect}" IsEnabled="{Binding CanChangeAutoReconnect}"
                                      Margin="0,6,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding HeartRate}" FontSize="41" FontWeight="Bold"
                                       VerticalAlignment="Center" AutomationProperties.Name="Heart rate"/>
                            <Border Grid.Column="1" Padding="12,0,0,0" BorderThickness="1,0,0,0"
                                    BorderBrush="{StaticResource LineBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Battery}" FontWeight="SemiBold" FontSize="19" AutomationProperties.Name="Battery"/>
                                    <TextBlock Text="{Binding Charging, StringFormat='Charging {0}'}" Style="{StaticResource SecondaryText}"/>
                                    <ToggleButton x:Name="BatteryHistoryToggle" MinHeight="24" HorizontalAlignment="Left"
                                                  Foreground="{StaticResource Accent}" AutomationProperties.Name="24 h history">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="0,3">
                                                    <TextBlock Text="24 h history" TextDecorations="Underline" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,7,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LastHeartRate, StringFormat='Last sample {0}'}"
                                       Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="Last 60 s" Style="{StaticResource SecondaryText}"/>
                        </DockPanel>
                        <Grid Height="94">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,5,0">
                                <TextBlock x:Name="HeartRateAxisHigh" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                                <TextBlock x:Name="HeartRateAxisMid" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                                <TextBlock x:Name="HeartRateAxisLow" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                            <Border Grid.Column="1" Background="{StaticResource InsetSurface}" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <UniformGrid Rows="4" Columns="1" IsHitTestVisible="False">
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"/>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"/>
                                    </UniformGrid>
                                    <Canvas x:Name="HeartRateGraphCanvas" SizeChanged="HeartRateGraphCanvas_SizeChanged">
                                        <Path x:Name="HeartRateGraphPath" Stroke="{StaticResource Accent}" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                                    </Canvas>
                                    <TextBlock x:Name="HeartRateGraphEmptyText" Text="Waiting for heart-rate samples…"
                                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,7,0,0">
                            <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetHeartRateCommand}"
                                    MinHeight="26" Padding="9,2" ToolTip="Clear the heart-rate graph and min/max"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Min" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MinimumHeartRate}" FontWeight="SemiBold" Margin="5,0,15,0"/>
                                <TextBlock Text="Max" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MaximumHeartRate}" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsChecked, ElementName=BatteryHistoryToggle, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="Battery history · last 24 hours" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Height="110" Background="{StaticResource InsetSurface}" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <Canvas x:Name="BatteryChargingIntervalsCanvas" Margin="34,8,8,20" IsHitTestVisible="False"/>
                                    <Canvas x:Name="BatteryHistoryGraphCanvas" Margin="34,8,8,20" IsHitTestVisible="False"
                                            SizeChanged="BatteryHistoryGraphCanvas_SizeChanged">
                                        <Path x:Name="BatteryHistoryGraphPath" Stroke="{StaticResource Accent}" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="BatteryHistoryEmptyText" Text="No battery history yet"
                                               Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="100%" FontSize="10" Margin="3,4,0,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="50%" FontSize="10" Margin="6,0,0,10" VerticalAlignment="Center"/>
                                    <TextBlock Text="0%" FontSize="10" Margin="10,0,0,17" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="-24 h" FontSize="10" Margin="34,0,0,3" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="Now" FontSize="10" Margin="0,0,8,3" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="BatteryHistorySummaryText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding OutputButtonText}" Command="{Binding OutputCommand}"
                                    Style="{StaticResource PrimaryButton}" MinWidth="90" VerticalAlignment="Top"/>
                            <TextBlock DockPanel.Dock="Left" Text="VRC" Style="{StaticResource SectionTitle}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding OutputState}" Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </DockPanel>
                        <TextBlock Text="{Binding LastOutput}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,9,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Content="固定BPM" Target="{Binding ElementName=FixedBpmInput}" Padding="0" VerticalAlignment="Center"/>
                            <DockPanel Grid.Column="1" LastChildFill="False">
                                <TextBox x:Name="FixedBpmInput" Width="58" Margin="0,0,8,0"
                                         Text="{Binding FixedBpm, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="固定BPMを出力" IsChecked="{Binding UseFixedBpm}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Label Grid.Row="1" Content="心拍が途切れたとき" Target="{Binding ElementName=LossModePicker}"
                                   Margin="0,7,0,0" Padding="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="LossModePicker" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                                      SelectedValuePath="Tag" SelectedValue="{Binding LossMode, Mode=TwoWay}">
                                <ComboBoxItem Content="最終値を保持" Tag="{x:Static models:HeartRateLossMode.HoldLast}"/>
                                <ComboBoxItem Content="固定BPMに自動切り替え" Tag="{x:Static models:HeartRateLossMode.UseFixedBpm}"/>
                                <ComboBoxItem Content="指定値に固定" Tag="{x:Static models:HeartRateLossMode.UseSpecifiedValue}"/>
                            </ComboBox>
                            <Label Grid.Row="2" Content="途絶時の指定値" Target="{Binding ElementName=SpecifiedValueInput}"
                                   Padding="0" Margin="0,7,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding ShowSpecifiedValue, Converter={StaticResource BooleanVisibility}}"/>
                            <TextBox x:Name="SpecifiedValueInput" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0"
                                     Width="82" HorizontalAlignment="Left" Text="{Binding SpecifiedValue, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowSpecifiedValue, Converter={StaticResource BooleanVisibility}}"
                                     ToolTip="選択したOSC型でそのまま送信する値です。"/>
                        </Grid>

                        <Expander x:Name="ParameterSettings" Style="{StaticResource Disclosure}" Margin="0,10,0,0"
                                  Background="{StaticResource InsetSurface}" AutomationProperties.Name="パラメーター設定">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueType, StringFormat=' / {0}'}"
                                               Margin="0,0,2,0" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ParameterName}" MaxWidth="126"
                                               TextTrimming="CharacterEllipsis" Margin="6,0,0,0" Style="{StaticResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="パラメーター設定" FontWeight="SemiBold"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Label Content="パラメーター名" Target="{Binding ElementName=ParameterNameInput}" Padding="0,5,0,3"/>
                                <TextBox x:Name="ParameterNameInput" Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditOsc}"/>
                                <TextBlock Text="{Binding OscAddress}" FontFamily="Consolas" Margin="0,4,0,0"
                                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="型" Target="{Binding ElementName=OscTypePicker}" Padding="0,0,0,3"/>
                                        <ComboBox x:Name="OscTypePicker" SelectedValuePath="Tag" SelectedValue="{Binding ValueType}"
                                                  IsEnabled="{Binding CanEditOsc}">
                                            <ComboBoxItem Content="Float" Tag="{x:Static models:OscValueType.Float}"/>
                                            <ComboBoxItem Content="Int" Tag="{x:Static models:OscValueType.Int}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="スケーリング" Target="{Binding ElementName=ScalingPicker}" Padding="0,0,0,3"/>
                                        <ComboBox x:Name="ScalingPicker" SelectedValuePath="Tag" SelectedValue="{Binding Scaling}"
                                                  IsEnabled="{Binding CanEditScaling}">
                                            <ComboBoxItem Content="BPM ÷ 255" Tag="{x:Static models:ScalingMode.Normalize255}"/>
                                            <ComboBoxItem Content="Raw BPM" Tag="{x:Static models:ScalingMode.RawBpm}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Label Content="送信間隔" Target="{Binding ElementName=IntervalInput}" Padding="0"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="IntervalInput" Width="70" Text="{Binding OscInterval, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding CanEditOsc}"/>
                                    <TextBlock Text="秒" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Expander x:Name="OscSettings" Style="{StaticResource Disclosure}" Margin="0,0,0,10" AutomationProperties.Name="OSC">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OscEndpoint}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                       Margin="8,0,2,0" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                            <TextBlock Text="OSC" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="IPアドレス" Target="{Binding ElementName=OscHostInput}" Padding="0,5,0,3"/>
                                <TextBox x:Name="OscHostInput" Text="{Binding OscHost, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditOsc}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="ポート" Target="{Binding ElementName=OscPortInput}" Padding="0,5,0,3"/>
                                <TextBox x:Name="OscPortInput" Text="{Binding OscPort, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditOsc}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="初期値に戻す" Command="{Binding ResetOscCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>

                <Expander Header="リング詳細" Style="{StaticResource Disclosure}" AutomationProperties.Name="リング詳細">
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceAddress, StringFormat='Bluetooth ID  {0}'}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DeviceModel}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DeviceFirmware}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ConnectionDetails}" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
