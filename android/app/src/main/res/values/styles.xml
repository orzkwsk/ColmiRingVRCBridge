<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">ColmiRing VRC Bridge</string>
    <string name="heart_rate">%1$s BPM</string>
    <string name="heart_received_at">Last sample %1$s</string>
    <string name="battery_reading">%1$d%% · %2$s</string>
    <string name="stale_value">%1$s (stale)</string>
    <string name="battery_history_empty">History is kept in memory while the app is open.</string>
    <plurals name="battery_history_summary">
        <item quantity="one">%1$d%% → %2$d%%  (%3$s pp) · %4$d stored sample</item>
        <item quantity="other">%1$d%% → %2$d%%  (%3$s pp) · %4$d stored samples</item>
    </plurals>
    <string name="last_output">最終送信 %1$s</string>
    <string name="disclosure_collapsed">▸  %1$s</string>
    <string name="disclosure_expanded">▾  %1$s</string>
    <string name="ring_details">Bluetooth ID  %1$s\n%2$s\n%3$s</string>
    <string name="ring_diagnostics" tools:ignore="PluralsCandidate">"Telemetry: %1$s\nHR packets: %2$d    Battery packets: %3$d\nHR polls: %4$d    Failed: %5$d\nBattery polls: %6$d    Failed: %7$d\nValid / invalid packets: %8$d / %9$d"</string>
    <string name="ring_last_warning">Last BLE warning: %1$s</string>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#79E3BA</item>
        <item name="android:windowBackground">#10191C</item>
        <item name="android:statusBarColor">#10191C</item>
        <item name="android:navigationBarColor">#10191C</item>
    </style>
</resources>
